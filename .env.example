# ── Leave everything blank to run in DEMO MODE (simulated calls, in-memory data). ──

# Dashboard login (set this before you deploy — the app can place phone calls)
DASHBOARD_PASSWORD=

# Your public URL once deployed (used for webhooks, bid links, cancel audio)
APP_URL=http://localhost:3000

# Your identity on calls and emails
BROKER_NAME=
COMPANY_NAME=
CALLBACK_PHONE=

# Until a database is connected, data is saved to a file in this folder (default: .data inside the app)
DATA_DIR=

# Supabase (history database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (document extraction)
ANTHROPIC_API_KEY=

# ElevenLabs (voice agents)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_CARRIER_AGENT_ID=
ELEVENLABS_CUSTOMER_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret the voice agents send when they call back into this app
TOOL_SECRET=

# Twilio (same account as the number imported into ElevenLabs — used to cut in
# on the other calls the moment a truck is booked)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend (carrier emails)
RESEND_API_KEY=
EMAIL_FROM=
